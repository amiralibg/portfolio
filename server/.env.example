# Copy to .env and fill in. Never commit the filled-in file.

# Port the API listens on. Must match the Dockerfile EXPOSE and the Dokploy
# domain config.
PORT=8000

# Comma-separated list of origins allowed to POST the form. No trailing slash.
# Include localhost while developing.
CORS_ORIGINS=https://amiralibg.xyz,https://www.amiralibg.xyz,http://localhost:5173

# ---- storage + admin ----
# SQLite file holding received messages. In production this MUST point at a
# mounted Dokploy volume, otherwise every redeploy throws the inbox away.
DB_FILE=./data/messages.db

# Password for the /admin inbox. Generate a real one:
#   openssl rand -base64 48
# Anyone with this string can read every message you have ever received.
ADMIN_TOKEN=change-me-generate-with-openssl-rand-base64-48

# ---- notifications (OPTIONAL) ----
# Messages are stored and readable at /admin whether or not this is set. This
# only decides whether your phone buzzes when one arrives.
#
# Setup, takes about a minute:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#      It hands you a token like 123456789:AAE...
#   2. Send your new bot any message (it can't message you until you do).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#      result[0].message.chat.id — that's your chat id.
# TELEGRAM_BOT_TOKEN=123456789:AAE...
# TELEGRAM_CHAT_ID=123456789

# Only used to append a link to the inbox at the end of each notification.
# SITE_URL=https://amiralibg.xyz
